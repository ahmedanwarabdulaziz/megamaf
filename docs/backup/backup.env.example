# Database (prefer the Supabase session pooler)
BACKUP_DB_HOST=your-session-pooler-host
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=postgres
BACKUP_DB_USER=your-pooler-user
SUPABASE_DB_PASSWORD=store-this-secret-outside-git

# Optional local destination
BACKUP_OUTPUT_DIR=D:\MegaMaf Backups

# R2 (required only for incremental/full attachment backups)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=store-this-secret-outside-git
R2_SECRET_ACCESS_KEY=store-this-secret-outside-git
R2_BUCKET_NAME=your-primary-bucket
R2_BUCKET_NAME_TREASURY=your-treasury-bucket

# Google Drive (required only for automatic upload)
GOOGLE_DRIVE_CLIENT_ID=store-this-secret-outside-git
GOOGLE_DRIVE_CLIENT_SECRET=store-this-secret-outside-git
GOOGLE_DRIVE_REFRESH_TOKEN=store-this-secret-outside-git
GOOGLE_DRIVE_FOLDER_ID=the-selected-private-folder-id
GOOGLE_DRIVE_TARGET_PARENT_ID=the-existing-parent-folder-id
